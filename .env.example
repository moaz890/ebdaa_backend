PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ebdaa?retryWrites=true&w=majority
JWT_SECRET=change_this_to_a_long_random_secret_string_in_production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Cloudinary — required for CMS image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name

# Option A (recommended): unsigned upload preset — works with read-only API keys
# Create at: Cloudinary Dashboard → Settings → Upload → Add upload preset
# Set Signing Mode to "Unsigned", folder to "aleabda", allow unsigned transformations
CLOUDINARY_UPLOAD_PRESET=aleabda_cms

# Option B: signed server upload — API key must have upload/write permission (not read-only)
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
